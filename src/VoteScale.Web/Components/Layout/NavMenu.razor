@using Microsoft.AspNetCore.Components.Authorization
@using VoteScale.Web.Auth
@inject AuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject ToastService ToastService

<nav class="navbar navbar-dark">
    <div class="nav-scrollable @(collapseNavMenu ? "" : "open")">
        <ul class="nav flex-column">
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu"></span> Home
                </NavLink>
            </li>

            <AuthorizeView>
                <Authorized>
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="/admin">
                            <span class="bi bi-list-nested-nav-menu"></span> Admin
                        </NavLink>
                    </li>
                    <li class="nav-item px-3">
                        <button class="nav-link logout-btn btn btn-link" @onclick="Logout">
                            <span class="bi bi-box-arrow-right"></span> Logout
                        </button>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="/login" Match="NavLinkMatch.All">
                            <span class="bi bi-plus-square-fill-nav-menu"></span> Login
                        </NavLink>
                    </li>
                </NotAuthorized>
            </AuthorizeView>

        </ul>
    </div>
</nav>


@code {
    private bool collapseNavMenu = true;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void Logout()
    {
        if (Auth is SimpleAuthProvider simple)
        {
            simple.Logout();
        }
        ToastService.ShowSuccess("Você saiu do sistema.");
        Navigation.NavigateTo("/login");
    }
}
